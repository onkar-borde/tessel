{
  "manifest_version": 3,
  "name": "Tessel",
  "version": "0.8.0",
  "description": "Persistent highlights and comments for claude.ai and chatgpt.com chats, with keyboard shortcuts and a shareable HTML export.",
  "minimum_chrome_version": "105",
  "permissions": [
    "alarms",
    "contextMenus",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "lib/sites.js",
        "lib/library.js",
        "lib/anchor.js",
        "lib/export.js",
        "lib/keys.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tessel",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "highlight-selection": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Highlight the selected text (last-used colour)"
    },
    "comment-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Highlight the selected text and add a comment"
    }
  },
  "options_ui": {
    "page": "library/library.html",
    "open_in_tab": true
  },
  "optional_permissions": [
    "downloads"
  ]
}
